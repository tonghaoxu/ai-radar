{
  "name": "ai-news-hub",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "seed": "tsx scripts/seed.ts",
    "seed:products": "tsx scripts/seed-products.ts",
    "crawl": "tsx scripts/crawl.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components hooks lib scripts tests *.ts *.json *.md",
    "format:check": "prettier --check app components hooks lib scripts tests *.ts *.json *.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@next/env": "^16.3.4",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  }
}
